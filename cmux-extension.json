{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux-extension.schema.json",
  "manifestVersion": 1,
  "id": "gh-dash",
  "name": "GitHub Dashboard",
  "version": "0.1.0",
  "description": "PRs and issues dashboard (gh-dash) as a cmux Dock pane. Requires the GitHub CLI, signed in.",
  "icon": "rectangle.grid.2x2",
  "build": [
    { "command": ["gh", "extension", "install", "dlvhdr/gh-dash"] }
  ],
  "panes": [
    {
      "id": "dash",
      "title": "PRs & issues",
      "command": ["gh", "dash"]
    }
  ]
}
